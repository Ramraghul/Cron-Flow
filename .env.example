# ─────────────────────────────────────────────────────────────────────────────
# CronFlow environment template
#
#   cp .env.example .env
#
# Every variable is validated at startup (src/config/env.validation.ts). The app
# refuses to boot, listing each problem, if a value is missing or malformed.
# Note: dotenv does not support inline comments — keep comments on their own line.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3000

# ── Data stores (REQUIRED) ───────────────────────────────────────────────────
# These match docker-compose.yml. Start them with: docker compose up -d postgres redis
DATABASE_URL=postgresql://cronflow:cronflow@localhost:5432/cronflow?schema=public
REDIS_URL=redis://localhost:6379

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (at least 32 characters required in production)
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32
# Access-token lifetime: <number><s|m|h|d>
JWT_EXPIRES_IN=1d
# bcrypt cost factor (4-15). Each +1 doubles hashing time.
BCRYPT_SALT_ROUNDS=12

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=*
# Reverse-proxy hops to trust for the client IP (use 1 behind Render, Heroku, or a load balancer)
TRUST_PROXY_HOPS=0
# Serve Swagger UI at /docs and the raw OpenAPI spec at /docs-json
SWAGGER_ENABLED=true

# ── Rate limiting (per client IP) ────────────────────────────────────────────
# Window length in milliseconds
THROTTLE_TTL=60000
# Max requests per window
THROTTLE_LIMIT=100

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── Execution engine ─────────────────────────────────────────────────────────
# Run the BullMQ worker inside the API process. Set to false when running
# `npm run start:worker` as a separate process (recommended in production).
WORKER_ENABLED=true
# Workflow executions processed in parallel per worker process
WORKER_CONCURRENCY=5
# Reconcile Redis cron schedulers with ACTIVE workflows when the API boots
SCHEDULER_SYNC_ON_BOOT=true
# SSRF guard: allow HTTP steps to call loopback/private-network addresses.
# Set true locally if you want steps to call services on localhost. Keep false in production.
HTTP_STEP_ALLOW_PRIVATE_NETWORKS=false
